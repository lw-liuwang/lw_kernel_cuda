ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -fno-strict-overflow -Wsign-compare -DNDEBUG -g -O2 -Wall -fPIC -I/workspace/lw-kernel-cuda/include -I/usr/local/lib/python3.12/dist-packages/torch/include -I/usr/local/lib/python3.12/dist-packages/torch/include/torch/csrc/api/include -I/usr/local/lib/python3.12/dist-packages/torch/include/TH -I/usr/local/lib/python3.12/dist-packages/torch/include/THC -I/usr/local/cuda/include -I/usr/include/python3.12 -c
post_cflags = -O3 -fdiagnostics-color=always -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/workspace/lw-kernel-cuda/include -I/usr/local/lib/python3.12/dist-packages/torch/include -I/usr/local/lib/python3.12/dist-packages/torch/include/torch/csrc/api/include -I/usr/local/lib/python3.12/dist-packages/torch/include/TH -I/usr/local/lib/python3.12/dist-packages/torch/include/THC -I/usr/local/cuda/include -I/usr/include/python3.12 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /workspace/lw-kernel-cuda/build/temp.linux-x86_64-cpython-312/workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/conv2d.o: cuda_compile /workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/conv2d.cu
build /workspace/lw-kernel-cuda/build/temp.linux-x86_64-cpython-312/workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/flash_attention.o: cuda_compile /workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/flash_attention.cu
build /workspace/lw-kernel-cuda/build/temp.linux-x86_64-cpython-312/workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/histogram.o: cuda_compile /workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/histogram.cu
build /workspace/lw-kernel-cuda/build/temp.linux-x86_64-cpython-312/workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/matmul.o: cuda_compile /workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/matmul.cu
build /workspace/lw-kernel-cuda/build/temp.linux-x86_64-cpython-312/workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/prefix_sum.o: cuda_compile /workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/prefix_sum.cu
build /workspace/lw-kernel-cuda/build/temp.linux-x86_64-cpython-312/workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/reduce.o: cuda_compile /workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/reduce.cu
build /workspace/lw-kernel-cuda/build/temp.linux-x86_64-cpython-312/workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/rmsnorm.o: cuda_compile /workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/rmsnorm.cu
build /workspace/lw-kernel-cuda/build/temp.linux-x86_64-cpython-312/workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/softmax.o: cuda_compile /workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/softmax.cu
build /workspace/lw-kernel-cuda/build/temp.linux-x86_64-cpython-312/workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/transpose.o: cuda_compile /workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/transpose.cu
build /workspace/lw-kernel-cuda/build/temp.linux-x86_64-cpython-312/workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/vec_add.o: cuda_compile /workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/cuda/vec_add.cu
build /workspace/lw-kernel-cuda/build/temp.linux-x86_64-cpython-312/workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/extension.o: compile /workspace/lw-kernel-cuda/lw_kernel_cuda/csrc/extension.cpp






